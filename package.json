{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "configs",
  "version": "2.5.0",
  "private": true,
  "description": "🍱 Crucial Configs",
  "keywords": [
    "configs"
  ],
  "homepage": "https://github.com/nozomiishii/configs#readme",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git"
  },
  "type": "module",
  "main": "README.md",
  "scripts": {
    "clean:all": "git clean -fdX",
    "clean:node": "npkill --delete-all -y",
    "fix:md": "markdownlint-cli2 --fix '**/*.md'",
    "format": "pnpm oxfmt --check '!packages/**' .",
    "format:fix": "pnpm oxfmt '!packages/**' .",
    "oxfmt": "oxfmt --no-error-on-unmatched-pattern",
    "postinstall": "pnpm -r run build && postinstall"
  },
  "devDependencies": {
    "@nozomiishii/commitlint-config": "workspace:*",
    "@nozomiishii/lefthook-config": "workspace:*",
    "@nozomiishii/markdownlint-cli2-config": "workspace:*",
    "@nozomiishii/oxfmt-config": "workspace:*",
    "@nozomiishii/postinstall": "workspace:*",
    "@nozomiishii/tsconfig": "workspace:*",
    "lefthook": "2.1.12",
    "markdownlint-cli2": "0.23.2",
    "npkill": "0.12.2",
    "oxfmt": "0.66.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
