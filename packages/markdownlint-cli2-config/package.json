{
  "name": "@nozomiishii/markdownlint-cli2-config",
  "version": "1.12.0",
  "description": "Nozomi's Recommended markdownlint-cli2 config",
  "keywords": [
    "markdownlint-cli2",
    "markdown",
    "lint",
    "config"
  ],
  "homepage": "https://github.com/nozomiishii/configs/blob/main/packages/markdownlint-cli2-config/README.md",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git",
    "directory": "packages/markdownlint-cli2-config"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "bin/cli.sh",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "lint": "eslint --max-warnings=0 .",
    "prepublishOnly": "pnpm run build",
    "tsc": "tsc"
  },
  "dependencies": {
    "markdownlint-cli2": "0.23.2"
  },
  "devDependencies": {
    "@nozomiishii/eslint-config": "workspace:*",
    "@nozomiishii/tsconfig": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
