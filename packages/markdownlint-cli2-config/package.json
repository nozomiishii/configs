{
  "name": "@nozomiishii/markdownlint-cli2-config",
  "version": "2.6.0",
  "description": "Nozomi's Recommended markdownlint-cli2 config",
  "keywords": [
    "config",
    "lint",
    "markdown",
    "markdownlint-cli2"
  ],
  "homepage": "https://github.com/nozomiishii/configs/blob/main/packages/markdownlint-cli2-config/README.md",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git",
    "directory": "packages/markdownlint-cli2-config"
  },
  "bin": "bin/cli.sh",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "format": "pnpm oxfmt . --check",
    "lint": "eslint --max-warnings=0 .",
    "prepublishOnly": "pnpm run build",
    "tsc": "tsc"
  },
  "dependencies": {
    "markdownlint-cli2": "0.23.2"
  },
  "devDependencies": {
    "@nozomiishii/eslint-config": "workspace:*",
    "@nozomiishii/tsconfig": "workspace:*",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
