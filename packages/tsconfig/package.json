{
  "name": "@nozomiishii/tsconfig",
  "version": "1.13.0",
  "description": "Nozomi's Recommended tsconfig",
  "keywords": [
    "tsconfig",
    "config"
  ],
  "homepage": "https://github.com/nozomiishii/configs/blob/main/packages/tsconfig/README.md",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git",
    "directory": "packages/tsconfig"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "type": "module",
  "exports": {
    ".": "./src/tsconfig.json",
    "./tsconfig.json": "./src/tsconfig.json",
    "./tsconfig.bundler.json": "./src/tsconfig.bundler.json",
    "./tsconfig.lib.json": "./src/tsconfig.lib.json",
    "./tsconfig.nextjs.json": "./src/tsconfig.nextjs.json",
    "./tsconfig.tanstack-start.json": "./src/tsconfig.tanstack-start.json",
    "./tsconfig.tsc.json": "./src/tsconfig.tsc.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.json",
    "README.md"
  ],
  "scripts": {
    "link": "pnpm link --global",
    "lint": "eslint --max-warnings=0 ."
  },
  "devDependencies": {
    "@nozomiishii/eslint-config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
