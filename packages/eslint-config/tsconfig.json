{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@nozomiishii/tsconfig",
  "compilerOptions": {
    // ----------------------------------------------------------------
    // Transpiling
    // ----------------------------------------------------------------
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,

    // ----------------------------------------------------------------
    // Types
    // ----------------------------------------------------------------
    "types": ["node"]
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist"]
}
