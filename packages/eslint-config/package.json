{
  "name": "@nozomiishii/eslint-config",
  "version": "2.3.1",
  "description": "Nozomi's Recommended eslint config",
  "keywords": [
    "config",
    "eslint",
    "lint"
  ],
  "homepage": "https://github.com/nozomiishii/configs/blob/main/packages/eslint-config/README.md",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git",
    "directory": "packages/eslint-config"
  },
  "bin": {
    "nozo-eslint-init": "./bin/nozo-eslint-init.js"
  },
  "files": [
    "bin",
    "dist",
    "index.ts",
    "presets",
    "rules",
    "starters",
    "types",
    "utils",
    "eslint-typegen.d.ts",
    "README.md",
    "README.ja.md"
  ],
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./init": "./dist/init/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check:ts": "tsc",
    "dev": "pnpm typegen && eslint --inspect-config",
    "eslint": "eslint --max-warnings=0",
    "format": "pnpm oxfmt . --check",
    "link": "pnpm link --global",
    "lint": "pnpm eslint .",
    "lint:fix": "pnpm eslint . --fix",
    "prepare": "pnpm run typegen",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "typegen": "node --import @swc-node/register/esm-register scripts/typegen.ts"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint-react/eslint-plugin": "5.18.6",
    "@eslint/config-inspector": "3.3.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@swc-node/register": "1.12.1",
    "@tanstack/eslint-plugin-query": "5.102.2",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "24.13.3",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-config-flat-gitignore": "2.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-de-morgan": "2.1.3",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-package-json": "1.7.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-playwright": "2.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "eslint-plugin-regexp": "3.2.0",
    "eslint-plugin-storybook": "10.5.10",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-typegen": "2.3.1",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "jsonc-eslint-parser": "3.3.0",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.67.0"
  },
  "devDependencies": {
    "eslint": "10.9.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "eslint": "10.9.0",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}
