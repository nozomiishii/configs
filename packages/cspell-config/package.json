{
  "name": "@nozomiishii/cspell-config",
  "version": "2.3.0",
  "description": "Nozomi's Recommended cspell config",
  "keywords": [
    "config",
    "cspell"
  ],
  "homepage": "https://github.com/nozomiishii/configs/blob/main/packages/cspell-config/README.md",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git",
    "directory": "packages/cspell-config"
  },
  "bin": {
    "nozo-cspell": "./dist/cli.js"
  },
  "files": [
    "dictionaries",
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "format": "pnpm oxfmt . --check",
    "lint": "eslint --max-warnings=0 .",
    "prepublishOnly": "pnpm run build",
    "tsc": "tsc"
  },
  "dependencies": {
    "cspell": "10.0.1"
  },
  "devDependencies": {
    "@nozomiishii/eslint-config": "workspace:*",
    "@nozomiishii/tsconfig": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
