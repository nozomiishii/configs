{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@nozomiishii/tsconfig/tsconfig.json",

  "compilerOptions": {
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "bin/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
