{
  "name": "@nozomiishii/lefthook-config",
  "version": "2.5.0",
  "description": "Nozomi's Recommended lefthook config",
  "keywords": [
    "config",
    "githooks",
    "lefthook"
  ],
  "homepage": "https://github.com/nozomiishii/configs/blob/main/packages/lefthook-config/README.md",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git",
    "directory": "packages/lefthook-config"
  },
  "bin": {
    "nozo-git-harvest": "./bin/nozo-git-harvest.js",
    "nozo-lefthook-init": "./bin/nozo-lefthook-init.js"
  },
  "files": [
    "bin",
    "dist",
    "hooks",
    "recommended.yaml",
    "starter.yaml",
    "README.md"
  ],
  "type": "module",
  "main": "recommended.yaml",
  "exports": {
    ".": "./recommended.yaml",
    "./init": "./dist/init/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "format": "pnpm oxfmt . --check",
    "lint": "eslint --max-warnings=0 .",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "tsc": "tsc"
  },
  "dependencies": {
    "git-harvest": "0.3.5"
  },
  "devDependencies": {
    "@nozomiishii/eslint-config": "workspace:*",
    "@nozomiishii/tsconfig": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "lefthook": "2.1.12",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "lefthook": "2.1.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
