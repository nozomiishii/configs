{
  "name": "nozo",
  "version": "2.3.1",
  "description": "nozo shared configs CLI",
  "keywords": [
    "cli",
    "config"
  ],
  "homepage": "https://github.com/nozomiishii/configs/blob/main/packages/nozo/README.md",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git",
    "directory": "packages/nozo"
  },
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "format": "pnpm oxfmt . --check",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --max-warnings=0 . --fix",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "tsc": "tsc"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@nozomiishii/commitlint-config": "workspace:*",
    "@nozomiishii/eslint-config": "workspace:*",
    "@nozomiishii/lefthook-config": "workspace:*",
    "@nozomiishii/oxfmt-config": "workspace:*",
    "@nozomiishii/postinstall": "workspace:*",
    "@nozomiishii/prettier-config": "workspace:*",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "package-manager-detector": "1.8.0",
    "which": "7.0.0"
  },
  "devDependencies": {
    "@nozomiishii/tsconfig": "workspace:*",
    "@types/node": "24.13.3",
    "@types/which": "3.0.4",
    "eslint": "10.9.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}
