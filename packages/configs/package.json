{
  "name": "@nozomiishii/configs",
  "version": "2.6.0",
  "description": "Nozomi's Recommended config bundle",
  "keywords": [
    "config",
    "configs",
    "preset"
  ],
  "homepage": "https://github.com/nozomiishii/configs/blob/main/packages/configs/README.md",
  "bugs": {
    "url": "https://github.com/nozomiishii/configs/issues"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/configs.git",
    "directory": "packages/configs"
  },
  "bin": {
    "nozo-configs-init": "./bin/nozo-configs-init.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./init": "./dist/init/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "format": "pnpm oxfmt . --check",
    "lint": "eslint --max-warnings=0 .",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "tsc": "tsc"
  },
  "dependencies": {
    "@nozomiishii/commitlint-config": "workspace:*",
    "@nozomiishii/eslint-config": "workspace:*",
    "@nozomiishii/lefthook-config": "workspace:*",
    "@nozomiishii/oxfmt-config": "workspace:*",
    "@nozomiishii/postinstall": "workspace:*",
    "@nozomiishii/tsconfig": "workspace:*",
    "package-manager-detector": "1.8.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "eslint": "10.10.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
